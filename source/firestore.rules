rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  function hasOperationalUpdateAccess(profile) {
    let role = profile.get('role', null);
    let accessStatus = profile.get('accessStatus', null);
    return role is string
      && role.trim().lower() in ['admin', 'gerente', 'operador', 'caixa', 'vendedor']
      && (!(accessStatus is string) || accessStatus.trim().lower() != 'revoked');
  }
  function legacyWriterAllowed(storeId, domain) {
    let path = /databases/$(database)/documents/storeWriterAdmission/$(storeId);
    let control = get(path).data;
    return exists(path)
      && domain in ['sales', 'stock', 'receivables', 'cash']
      && control.schemaVersion == 1
      && control.policyRevision == 'f9-commercial-admission-1'
      && control.mode == 'legacy'
      && control.epoch is int && control.epoch > 0
      && control.epoch <= 9007199254740991
      && control.changedAt is timestamp
      && control.changedBy is string && control.changedBy.size() > 0
      && control.lastTransitionId is string && control.lastTransitionId.size() > 0;
  }
  // No app owner/admin or overlapping store wildcard can operate this root.
  match /storeWriterAdmission/{document=**} { allow read, write: if false; }
  match /writerAdmissionOperators/{document=**} { allow read, write: if false; }
  match /writerAdmissionEvidence/{document=**} { allow read, write: if false; }
  
    
    // 1. Usuários: O próprio usuário pode ler/escrever OU o admin/gerente da mesma loja pode ler a lista
    match /users/{userId} {

  allow read: if request.auth != null && (
    request.auth.uid == userId ||
    resource.data.storeId == request.auth.token.storeId ||
    (
      exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId
        == resource.data.storeId
    )
  );

  // Cadastro inicial por e-mail.
  // O Flutter pode criar APENAS o próprio documento básico.
  allow create: if request.auth != null
    && request.auth.uid == userId
    && request.resource.data.keys().hasOnly([
      'username',
      'email',
      'storeId',
      'createdAt'
    ])
    && request.resource.data.storeId == '';

  // Depois de criado, o próprio usuário pode alterar
  // apenas dados normais de perfil/aplicativo.
  allow update: if request.auth != null
    && request.auth.uid == userId
    && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          'fullName',
          'phone',
          'lastUpdated',
          'versao_app',
          'ultimo_login'
        ]);

  // Exclusão de users/{uid} pertence ao backend.
  allow delete: if false;
}
    
    // 2. CPFs/CNPJs cadastrados
// Coleção interna controlada exclusivamente pelo backend.
match /cpfs_cadastrados/{cpf} {
  allow read, write: if false;
}

// A2/03e: recibos privados de eventos Asaas (COLECAO RAIZ).
// Somente Cloud Functions com Admin SDK deve acessar esses registros.
// NUNCA colocar o ledger em subcolecao generica de stores: existe wildcard permissivo.
match /asaasWebhookEvents/{eventId} {
  allow read, write: if false;
}

     // 3. Documento principal da loja
match /stores/{storeId} {

  // Usuário só pode acessar a própria loja.
  allow read: if request.auth != null
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId;

  // A criação da loja pertence exclusivamente ao backend.
  allow create: if false;

  // Atualização permitida somente na própria loja
  // e sem alteração de campos sensíveis.
  allow update: if request.auth != null
    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == storeId
    && !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          'ownerId',
          'createdAt',
          'document',

          'asaasCustomerId',
          'asaasSubscriptionId',
          'asaasBindingEnvironment',
          'asaasBindingProjectId',

          'subscriptionStatus',
          'subscriptionType',
          'subscriptionPlanPrice',
          'subscriptionPlanChangedAt',
          'subscriptionPriceSyncedAt',

          'trialEndDate',
          'lastPaymentDate',
          'nextDueDate',
          'overdueSince',
          'overdueDueDate',
          'blockedAt',
          'subscriptionInactiveReason',
          'pendingPlanChange',
          'pendingPlanChangeRequestedAt',
          'subscriptionCreationStatus',
          'subscriptionCreationStartedAt',

          // Campos legados do antigo Google Play
          'productId',
          'purchaseDate'
        ]);

  // Exclusão da loja pelo cliente não é permitida.
  allow delete: if false;
}

// 4. Subcoleções da loja — TEMPORÁRIO
  
// 4. VENDAS
// Usuários da própria loja podem registrar e atualizar vendas.
//
// Depois que uma venda existe, alguns campos estruturais
// não podem mais ser alterados pelo aplicativo:
//
// • storeId
// • createdAt
// • localSaleId
// • syncOrigin
//
// Exclusão física não é permitida.
// Futuro cancelamento será realizado pelo backend.

match /stores/{storeId}/sales/{saleId} {

  allow read: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

   allow create: if request.auth != null
  && exists(
    /databases/$(database)/documents/users/$(request.auth.uid)
  )
  && get(
    /databases/$(database)/documents/users/$(request.auth.uid)
  ).data.storeId == storeId
  && hasOperationalUpdateAccess(get(
    /databases/$(database)/documents/users/$(request.auth.uid)
  ).data)
  && request.resource.data.storeId == storeId
  && legacyWriterAllowed(storeId, 'sales');

  allow update: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId
    && hasOperationalUpdateAccess(get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data)
    && legacyWriterAllowed(storeId, 'receivables')
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'isPaid', 'paidAmount', 'totalPaidAmount', 'paidAt', 'installments', 'lastPaymentDate', 'notes'
    ])
    && !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          'storeId',
          'createdAt',
          'localSaleId',
          'syncOrigin'
        ]);

// Venda nunca é apagada fisicamente pelo aplicativo.
// Futuro cancelamento será realizado de forma segura pelo backend.

 allow delete: if false;

 } // fecha match /stores/{storeId}/sales/{saleId}
  


// 4.1 AUDITORIA
// Usuários da própria loja podem consultar.
// Escrita pertence exclusivamente ao backend.

match /stores/{storeId}/auditLogs/{document=**} {

  allow read: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

  allow create, update, delete: if false;
}

// 4.2 PRODUTOS
// Usuários da própria loja podem ler/editar; criação exige createProduct.
// Campos de arquivamento são exclusivos do backend.
// Campos taxonômicos e COD não podem ser alterados diretamente pelo cliente.
// Exclusão física não é permitida.

match /stores/{storeId}/products/{productId} {

  allow read: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

  allow create: if false;

  allow update: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId
    && exists(/databases/$(database)/documents/stores/$(storeId))
    && legacyWriterAllowed(storeId, 'stock')
    && hasOperationalUpdateAccess(get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data)
    && !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          'cod',
          'categoryIds',
          'categoryId',
          'categoryName',
          'isArchived',
          'archivedAt',
          'archivedBy',
          'archiveReason',
          'productKind',
          'variantSchemaVersion',
          'productId',
          'variantId',
          'attributes',
          'attributeDefinitions',
          'priceCents',
          'costCents',
          'commercial',
          'commercialProfiles'
        ]);

  allow delete: if false;
}


match /stores/{storeId}/productCodes/{document=**} {
  allow read, write: if false;
}

// 4.3 CLIENTES
// Usuários da própria loja podem ler/criar/editar.
// Campos de arquivamento são exclusivos do backend.
// Exclusão física não é permitida.

match /stores/{storeId}/customers/{customerId} {

  allow read: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

  allow create: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId
    && !request.resource.data.keys().hasAny([
      'isArchived',
      'archivedAt',
      'archivedBy',
      'archiveReason'
    ]);

  allow update: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId
    && !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          'isArchived',
          'archivedAt',
          'archivedBy',
          'archiveReason'
        ]);

  allow delete: if false;
}


// 4.4 CATEGORIAS
// Usuários da própria loja podem ler; criação/edição exigem upsertCategory.
// Exclusão pertence exclusivamente a deleteCategory no backend.

match /stores/{storeId}/categories/{categoryId} {

  allow read: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

  allow create, update: if false;

  allow delete: if false;
}


// 4.5 FLUXO DE CAIXA
//
// O aplicativo pode consultar e registrar lançamentos.
// Depois de criado, um lançamento financeiro é imutável.
// Exclusão física não é permitida.

match /stores/{storeId}/cash_flow/{entryId} {

  allow read: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

  allow create: if request.auth != null
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId

    && hasOperationalUpdateAccess(get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data)

    && request.resource.data.keys().hasOnly([
      'description',
      'amount',
      'type',
      'createdAt'
    ])

    && request.resource.data.keys().hasAll([
      'description',
      'amount',
      'type',
      'createdAt'
    ])

    && request.resource.data.description is string
    && request.resource.data.amount is number
    && request.resource.data.amount > 0

    && (
      request.resource.data.type == 'Entrada'
      ||
      request.resource.data.type == 'Saída'
    )

    && request.resource.data.createdAt is timestamp
    && legacyWriterAllowed(storeId, 'cash');

  // Lançamentos existentes não são alterados pelo cliente.
  allow update: if false;

  // Lançamentos financeiros não são apagados fisicamente.
  allow delete: if false;
}

// 5. DEMAIS SUBCOLEÇÕES DA LOJA
//
// Mantém a política atual:
// • mesma loja pode ler/criar/editar
// • somente admin/gerente pode excluir
//
// "sales" possui regra própria.
// "auditLogs" possui regra própria e é somente backend para escrita.

match /stores/{storeId}/{subcollection}/{document=**} {

  allow read: if request.auth != null
    && subcollection != 'sales'
    && subcollection != 'auditLogs'
    && subcollection != 'products'
    && subcollection != 'productCodes'
    && subcollection != 'customers'
    && subcollection != 'categories'
    && subcollection != 'cash_flow'
    && subcollection != 'catalogRequests'
    && subcollection != 'storeWriterAdmission'
    && subcollection != 'writerAdmissionOperators'
    && subcollection != 'writerAdmissionEvidence'
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

  allow create, update: if request.auth != null
    && subcollection != 'sales'
    && subcollection != 'auditLogs'
    && subcollection != 'products'
    && subcollection != 'productCodes'
    && subcollection != 'customers'
    && subcollection != 'categories'
    && subcollection != 'cash_flow'
    && subcollection != 'catalogRequests'
    && subcollection != 'storeWriterAdmission'
    && subcollection != 'writerAdmissionOperators'
    && subcollection != 'writerAdmissionEvidence'
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId;

  allow delete: if request.auth != null
    && subcollection != 'sales'
    && subcollection != 'auditLogs'
    && subcollection != 'products'
    && subcollection != 'productCodes'
    && subcollection != 'customers'
    && subcollection != 'categories'
    && subcollection != 'cash_flow'
    && subcollection != 'catalogRequests'
    && subcollection != 'storeWriterAdmission'
    && subcollection != 'writerAdmissionOperators'
    && subcollection != 'writerAdmissionEvidence'
    && exists(
      /databases/$(database)/documents/users/$(request.auth.uid)
    )
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.storeId == storeId
    && (
      get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role == 'admin'
      ||
      get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role == 'gerente'
    );
}

match /stores/{storeId}/catalogRequests/{document=**} {
  allow read, write: if false;
}
  }
}
