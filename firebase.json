
{
"functions": [
  {
    "source": "functions",
    "runtime": "nodejs22",
    "gen": "1",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "tests/**"
    ],
    "codebase": "default",
    "predeploy": [
      "node scripts/check-bootstrap-codebase-migration.js"
    ]
  },
  {
    "source": "functions-bootstrap",
    "codebase": "bootstrap",
    "runtime": "nodejs22",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "tests/**"
    ]
  }
],
"firestore": {
"rules": "firestore.rules"
},
"storage": {
"rules": "storage.rules"
},
"emulators": {
"auth": {
"port": 9099
},
"firestore": {
"port": 8080
},
"storage": {
"port": 9199
},
"functions": {
"port": 5001
},
"ui": {
"enabled": true
},
"singleProjectMode": true
},
"hosting": {
"public": "build/web",
"ignore": [
"firebase.json",
"**/.*",
"**/node_modules/**"
],
"rewrites": [
{
"source": "**",
"destination": "/index.html"
}
]
}
}
