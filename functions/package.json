{
    "name": "functions",
    "description": "Cloud Functions for Firebase",
    "scripts": {
        "test:restore:r1g": "firebase emulators:exec --config ../firebase.json --project demo-store-connect-restore --only firestore \"node tests/restore/runRestoreFlowTests.js\"",
        "test:restore:r1f": "firebase emulators:exec --config ../firebase.json --project demo-store-connect-restore --only firestore \"node tests/restore/runRestoreResultTests.js\"",
        "test:restore:r1d": "firebase emulators:exec --config ../firebase.json --project demo-store-connect-restore --only firestore \"node tests/restore/runRestoreExistingStoreTests.js\"",
        "test:restore:r1c": "firebase emulators:exec --config ../firebase.json --project demo-store-connect-restore --only firestore \"node tests/restore/runRestoreEmulatorTests.js\"",
        "serve": "firebase emulators:start --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test:retention": "firebase emulators:exec --config ../firebase.json --project store-connect-app --only firestore,storage \"node tests/backups/runBackupRetentionTests.js\"",
        "test:catalog": "firebase emulators:exec --config ../firebase.json --project store-connect-app --only firestore \"node tests/catalog/runCatalogTests.js\""
    },
    "engines": {
        "node": "22"
    },
    "main": "index.js",
    "dependencies": {
        "axios": "^1.13.5",
        "firebase-admin": "^13.7.0",
        "firebase-functions": "^7.0.6"
    },
    "private": true,
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "firebase": "^12.18.0"
    }
}
